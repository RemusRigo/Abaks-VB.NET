<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
      <AssemblyName>Abaks</AssemblyName>
      <MyType>WindowsForms</MyType>
      <OutputType>WinExe</OutputType>
      <Platforms>x64;x86</Platforms>
      <StartupObject>Abaks.My.MyApplication</StartupObject>
      <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
      <TargetFrameworks Condition="'$(BuildingInsideVisualStudio)' == 'true'">net10.0-windows</TargetFrameworks>   <!-- inside Visual Studio use only one framework -->
      <UseWindowsForms>true</UseWindowsForms>
      <ApplicationIcon>Res\Main.ico</ApplicationIcon>
   </PropertyGroup>

   <PropertyGroup Condition="'$(TargetFramework)' != ''">
      <TfmName>$(TargetFramework.Replace('-windows', ''))</TfmName>
      <OutputPath>..\bin\$(Configuration)\$(TfmName) $(Platform)\</OutputPath>
      <IntermediateOutputPath>obj\$(Configuration)\$(TfmName) $(Platform)\</IntermediateOutputPath>
   </PropertyGroup>

<PropertyGroup Condition="'$(Platform)' == 'x86' Or '$(Platform)' == 'x64'">
   <PlatformTarget>$(Platform)</PlatformTarget>
</PropertyGroup>

   <ItemGroup>
     <Content Include="Res\Main.ico" />
   </ItemGroup>

   <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Forms\" />
    <Folder Include="API\" />
    <Folder Include="Modules\" />
  </ItemGroup>

</Project>